set_prop(vendor_init, audio_prop)
set_prop(vendor_init, vendor_alarm_boot_prop)
set_prop(vendor_init, vendor_bluetooth_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_thermal_normal_prop)
set_prop(vendor_init, vendor_video_prop)

allow vendor_init {
  proc_dirty
  proc
}:file w_file_perms;

allow vendor_init block_device:lnk_file setattr;

set_prop(vendor_init, vendor_fingerprint_prop)

# Allow vendor_init to set IPA device node permissions
allow vendor_init vendor_ipa_dev:file create_file_perms;

# Allow to shoot itself
allow vendor_init self:capability kill;

# Custom recoveries (OrangeFox .foxs, TWRP/OrangeFox recovery/) leave files on
# persist labelled media_rw_data_file. restorecon_recursive /mnt/vendor/persist
# stats them; vendor_init can't be given access to that core data type, and it
# has nothing to relabel there, so don't audit the walk.
dontaudit vendor_init media_rw_data_file:{ dir file } getattr;
