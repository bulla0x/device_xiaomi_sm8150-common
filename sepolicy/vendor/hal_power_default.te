dontaudit hal_power_default self:capability dac_override;

allow hal_power_default sysfs_touchpanel:dir search;
allow hal_power_default sysfs_touchpanel:file rw_file_perms;

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# cpufreq-hw specific
allow hal_power_default proc:file { write open };
allow hal_power_default sysfs:file { write open };

# ADPF: adjust scheduling of the threads in hint sessions
# (as in hardware/google/pixel-sepolicy/power-libperfmgr)
# Apps run with per-user MLS categories; setsched on them needs this.
typeattribute hal_power_default mlstrustedsubject;
allow hal_power_default self:capability sys_nice;
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default system_server:process setsched;

# Display idle state (libperfmgr InteractionHandler polls idle_state)
r_dir_file(hal_power_default, vendor_sysfs_graphics)
