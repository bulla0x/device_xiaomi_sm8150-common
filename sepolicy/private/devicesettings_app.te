type devicesettings_app, domain;
typeattribute devicesettings_app mlstrustedsubject;

app_domain(devicesettings_app)

# Access standard system services
allow devicesettings_app app_api_service:service_manager find;
allow devicesettings_app audioserver_service:service_manager find;
allow devicesettings_app cameraserver_service:service_manager find;
allow devicesettings_app drmserver_service:service_manager find;
allow devicesettings_app mediaextractor_service:service_manager find;
allow devicesettings_app mediametrics_service:service_manager find;
allow devicesettings_app mediaserver_service:service_manager find;

# Allow reading and writing shared prefs
allow devicesettings_app system_app_data_file:dir create_dir_perms;
allow devicesettings_app system_app_data_file:{ file lnk_file } create_file_perms;

# Allow binder communication with gpuservice
binder_call(devicesettings_app, gpuservice)

# Allow XiaomiParts to search sysfs_leds directory
allow devicesettings_app sysfs_leds:dir search;

# Allow XiaomiParts to read/write to sysfs_leds
allow devicesettings_app sysfs_leds:file rw_file_perms;

# Allow XiaomiParts to read and write sysfs_thermal (thermal_message/sconfig)
allow devicesettings_app sysfs_thermal:dir r_dir_perms;
allow devicesettings_app sysfs_thermal:file rw_file_perms;

# Allow XiaomiParts to track the foreground app for thermal profiles
allow devicesettings_app {
  activity_task_service
  thermal_service
}:service_manager find;

# Allow XiaomiParts to read CPU sysfs and proc stat for performance monitor
allow devicesettings_app sysfs_devices_system_cpu:dir search;
allow devicesettings_app sysfs_devices_system_cpu:file r_file_perms;
allow devicesettings_app proc_stat:file r_file_perms;

# Allow XiaomiParts to communicate with the Xiaomi motor HAL
hal_client_domain(devicesettings_app, hal_motor)
binder_call(devicesettings_app, hal_motor)
binder_call(hal_motor, devicesettings_app)

# SoundPool (pop-up camera sounds) decodes in-process; the extractor and the
# Codec2 software codec look up unset media tuning properties such as
# media.stagefright.extractremote and ro.com.android.media.swcodec.ion.*,
# which fall back to default_prop. Only coredomain may read that type, and the
# lookups return "unset" either way, so don't audit them.
dontaudit devicesettings_app default_prop:file read;
