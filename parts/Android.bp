android_app {
    name: "XiaomiParts",
    defaults: [
        "SettingsLibDefaults",
        "platform_app_defaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],

    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    use_embedded_native_libs: true,

    static_libs: [
        "org.lineageos.settings.resources",
        "//hardware/xiaomi:vendor.xiaomi.hardware.motor-V1.0-java",
        "SpaLib",
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation-core",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-service",
        "kotlinx-coroutines-core",
    ],

    kotlincflags: [
        "-Xjvm-default=all",
        "-opt-in=kotlin.RequiresOptIn",
        "-opt-in=androidx.compose.material3.ExperimentalMaterial3ExpressiveApi",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
    ],

    optimize: {
        enabled: true,
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "privapp_whitelist_co.infinity.xparts.xml",
    ],
}
